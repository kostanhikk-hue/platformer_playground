extends RefCounted
## Слои столкновений (биты) — единственное место, где они заданы. Таблица — «Технология/Архитектура» → «Слои столкновений».
##   const Layers := preload("res://core/layers.gd")
##   body.collision_mask = Layers.SOLID

const WORLD := 1     ## Мир: блоки уровня, тела компонентов, результат рисуемого контура со слоем «мир»
const ENEMY := 2     ## Враги (и разрушаемый блок): атаки героя ищут цели здесь
const PLAYER := 4    ## Герой
const STROKES := 8   ## Штрихи: линия, волна, результат рисуемого контура со слоем «штрихи» (слой 4 в Godot)

## «Твёрдое» = мир + штрихи: маска героя и манекенов и проверок, которые ищут опору или преграду.
const SOLID := WORLD | STROKES
